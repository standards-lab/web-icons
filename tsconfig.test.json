// Adapted from spike-html-hosting-icons (8b8d955): tsconfig.json, without eslint.config.js.
// Adapted from web-foundation (72e759f): tsconfig.test.json, its split from the build.
// The type check of the scripts, the suite, and the Vite fixtures, against dist/, never emitting.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts"]
}
