// Adapted from web-foundation (72e759f): tsconfig.json, for the plugin, which runs on node.
// The build of the plugin, src/ into dist/ beside the generated sets: tsc emits each module's .js
// and .d.ts. mise run types checks the same sources with --noEmit; tsconfig.test.json checks the
// scripts and the suite.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src"]
}
