// Adapted from spike-html-hosting-icons (8b8d955): tsconfig.json, without eslint.config.js, as
// web-foundation's (72e759f) type check leaves it out.
// The type check (mise run types), never emitting: the TypeScript of the scripts and the suite,
// which node runs under its type stripping, on node's module resolution and its types.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts"]
}
