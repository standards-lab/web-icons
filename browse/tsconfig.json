// The type check of the browse page's modules under the DOM's lib, never emitting.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["browse.js", "choice.js", "catalog.d.ts"]
}
