// Adapted from spike-html-hosting-icons (8b8d955): browse/tsconfig.json, checking JavaScript as
// the root tsconfig.json no longer does.
// The browse page's modules, browse.js and choice.js, type-checked as the browser runs them
// (mise run types:browse), never emitting: the DOM's lib, the catalog typed by catalog.d.ts, which
// names served.ts's shape, and the foundation's modules by their declarations, as the page's
// import map names them.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "declaration": false,
    "rootDir": "."
  },
  "include": ["browse.js", "choice.js", "catalog.d.ts"]
}
